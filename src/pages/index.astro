---
import Main from "../layouts/Main.astro";
---

<Main title="Home">
  <section class="hero-section">
    <h1>Hello! 👋</h1>
    <p class="intro">I'm Devarsh!</p>
    <p>
      I enjoy programming and computers. That is why I have made this website,
      built with <a href="https://astro.build">Astro</a>, to share stuff that
      you may find interesting!
    </p>
    <p>
      Feel free to take a look around my website! In the header are ways to
      contact me.
    </p>
  </section>
</Main>

<style>
  .hero-section {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 2.5em;
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.05),
      0 10px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hero-section:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 8px rgba(0, 0, 0, 0.08),
      0 12px 20px rgba(0, 0, 0, 0.12);
  }

  .hero-section h1 {
    font-size: 3.5em;
    margin-bottom: 0.3em;
    background: linear-gradient(135deg, #3939ef 0%, #6364ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .intro {
    font-size: 1.5em;
    font-weight: 600;
    color: rgb(var(--gray-dark));
    margin-bottom: 1.5em;
  }

  .hero-section a {
    position: relative;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .hero-section a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .hero-section a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 720px) {
    .hero-section {
      padding: 1.5em;
    }

    .hero-section h1 {
      font-size: 2.5em;
    }

    .intro {
      font-size: 1.3em;
    }
  }
</style>
